{
  "name": "gestor-de-gastos",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:web": "vite",
    "build": "vite build",
    "deploy": "npm run build && wrangler deploy",
    "db:init": "wrangler d1 migrations apply gastos-db --remote",
    "db:init:local": "wrangler d1 migrations apply gastos-db --local",
    "lint": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.worker.json && node scripts/prueba-filtros.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.546.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.1.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260910.1",
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^22.20.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.0.0"
  }
}
